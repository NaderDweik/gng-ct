# Register-interest form → WhatsApp (Meta WhatsApp Cloud API). Copy to .env.local / Vercel env.
# Without these, the form falls back to a "Send on WhatsApp" wa.me link.
WHATSAPP_TOKEN=            # permanent System User access token
WHATSAPP_PHONE_NUMBER_ID=  # the sending business number's Phone number ID
WHATSAPP_TO=962795898415   # the single number that receives leads (digits, no +)
WHATSAPP_TEMPLATE=register_interest
WHATSAPP_TEMPLATE_LANG=ar  # ar or en, must match the approved template's language
# WHATSAPP_API_VERSION=v23.0

# Cloudflare Turnstile (optional, recommended). Both keys or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
